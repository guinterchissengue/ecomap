                  },
                  "description": {
                    "type": "string",
                    "example": "Bring gloves and bags."
                  },
                  "report": {
                    "type": "string",
                    "example": "64b7f0c2a1b2c3d4e5f60718"
                  },
                  "scheduledDate": {
                    "type": "string",
                    "example": "2026-12-05T08:00:00.000Z"
                  },
                  "neighborhood": {
                    "type": "string",
                    "example": "Costa do Sol"
                  },
                  "volunteersNeeded": {
                    "type": "integer",
                    "example": 15
                  }
                },
                "required": [
                  "title",
                  "description",
                  "report",
                  "scheduledDate",
                  "neighborhood"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cleanup created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cleanup"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
