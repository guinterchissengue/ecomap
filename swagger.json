      },
      "post": {
        "tags": [
          "Cleanups"
        ],
        "summary": "Create a cleanup event for a report (login required, the organizer is the logged in user)",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
