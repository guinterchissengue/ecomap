            "type": "string"
          },
          "report": {
            "type": "string"
          },
          "organizer": {
            "type": "string"
          },
          "scheduledDate": {
            "type": "string",
            "format": "date-time"
          },
          "neighborhood": {
            "type": "string"
          },
          "volunteersNeeded": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "completed",
              "cancelled"
            ]
          },
